# Set the default behavior, in case people don't have core.autocrlf set.
# Keep LF as the repo-wide standard for all non-Windows-specific text files.
* text=auto eol=lf

# Explicitly declare text files that should keep native Windows line endings.
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary