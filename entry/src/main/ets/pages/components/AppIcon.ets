export class AppIconRes {
  static get(name: string, dark: boolean): Resource {
    const map: Record<string, Resource> = dark ? ICON_WHITE : ICON_DARK;
    const res: Resource | undefined = map[name];
    if (res !== undefined) {
      return res;
    }
    const fallback: Resource | undefined = map['more_vert'];
    if (fallback !== undefined) {
      return fallback;
    }
    return $r('app.media.startIcon');
  }
}

@Component
export struct AppIcon {
  @StorageProp('isDark') isDark: boolean = false;
  name: string = '';
  iconSize: number = 24;
  tint: ResourceColor = '';

  build() {
    if (this.tint !== '') {
      Image(AppIconRes.get(this.name, this.isDark))
        .width(this.iconSize)
        .height(this.iconSize)
        .fillColor(this.tint)
    } else {
      Image(AppIconRes.get(this.name, this.isDark))
        .width(this.iconSize)
        .height(this.iconSize)
    }
  }
}
